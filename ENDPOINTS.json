          "headers": {
            "Authorization": "Bearer <token>"
          },
          "query": {
            "page": "integer (default: 1)",
            "limit": "integer (default: 10)",
            "status": "string (draft, pending, approved, rejected)",
            "week_number": "integer",
            "date_from": "string YYYY-MM-DD",
            "date_to": "string YYYY-MM-DD"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": {
              "entries": "array",
              "pagination": "object"
            }
          }
        }
      },
      {
        "id": "log_get",
        "name": "Get Single Entry",
        "method": "GET",
        "path": "/log-entries/:id",
        "fullUrl": "/api/log-entries/:id",
        "protected": true,
        "requiredRole": ["student"],
        "description": "Get single log entry details",
        "params": {
          "id": "string (entry UUID)"
        },
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": "object (entry)"
          }
        }
      },
      {
        "id": "log_update",
        "name": "Update Log Entry",
        "method": "PUT",
        "path": "/log-entries/:id",
        "fullUrl": "/api/log-entries/:id",
        "protected": true,
        "requiredRole": ["student"],
        "description": "Update log entry (draft or pending only)",
        "params": {
          "id": "string (entry UUID)"
        },
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          },
          "body": {
            "date": "string YYYY-MM-DD (optional)",
            "week_number": "integer (optional)",
            "activity_description": "string (optional, min 50 chars)",
            "tools_equipment": "string (optional, min 10 chars)",
            "skills_acquired": "string (optional, min 10 chars)",
            "challenges_faced": "string (optional, min 10 chars)"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": "object (updated entry)"
          }
        }
      },
      {
        "id": "log_submit",
        "name": "Submit Log Entry",
        "method": "PUT",
        "path": "/log-entries/:id/submit",
        "fullUrl": "/api/log-entries/:id/submit",
