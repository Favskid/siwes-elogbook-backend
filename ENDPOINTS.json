{
  "baseUrl": "http://localhost:3000/api",
  "production": "https://yourdomain.com/api",
  "version": "1.0.0",
  "endpoints": {
    "auth": [
      {
        "id": "auth_register",
        "name": "Register",
        "method": "POST",
        "path": "/auth/register",
        "fullUrl": "/api/auth/register",
        "public": true,
        "description": "Create new user account",
        "request": {
          "body": {
            "name": "string (required)",
            "email": "string (required, valid email)",
            "password": "string (required, min 8 chars, 1 upper, 1 lower, 1 number, 1 special)",
            "role": "string (required, one of: student, industry_supervisor, school_supervisor, admin)",
            "matric_number": "string (required for students)",
            "department": "string (required)",
            "phone": "string (optional)"
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": {
              "user": "object",
              "token": "string (JWT)",
              "refreshToken": "string",
              "expiresIn": "string"
            }
          }
        },
        "rateLimited": true,
        "limit": "5 requests per 15 minutes"
      },
      {
        "id": "auth_login",
        "name": "Login",
        "method": "POST",
        "path": "/auth/login",
        "fullUrl": "/api/auth/login",
        "public": true,
        "description": "Login with email/matric and password",
        "request": {
          "body": {
            "emailOrMatric": "string (required)",
            "password": "string (required)",
            "role": "string (required)"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": {
              "user": "object",
              "token": "string (JWT)",
              "refreshToken": "string",
              "expiresIn": "string"
            }
          }
        },
        "rateLimited": true,
        "limit": "5 requests per 15 minutes"
      },
      {
        "id": "auth_refresh",
        "name": "Refresh Token",
        "method": "POST",
        "path": "/auth/refresh-token",
        "fullUrl": "/api/auth/refresh-token",
        "public": true,
        "description": "Get new access token using refresh token",
        "request": {
          "body": {
            "refreshToken": "string (required)"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": {
              "token": "string (new JWT)",
              "refreshToken": "string (new refresh token)",
              "expiresIn": "string"
            }
          }
        },
        "rateLimited": true
      },
      {
        "id": "auth_logout",
        "name": "Logout",
        "method": "POST",
        "path": "/auth/logout",
        "fullUrl": "/api/auth/logout",
        "protected": true,
        "description": "Logout and blacklist token",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": null
          }
        }
      },
      {
        "id": "auth_me",
        "name": "Get Current User",
        "method": "GET",
        "path": "/auth/me",
        "fullUrl": "/api/auth/me",
        "protected": true,
        "description": "Get authenticated user details",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": "object (user)"
          }
        }
      }
