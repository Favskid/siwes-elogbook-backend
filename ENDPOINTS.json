    "logEntries": [
      {
        "id": "log_create",
        "name": "Create Log Entry",
        "method": "POST",
        "path": "/log-entries",
        "fullUrl": "/api/log-entries",
        "protected": true,
        "requiredRole": ["student"],
        "description": "Create new log entry with file upload",
        "request": {
          "headers": {
            "Authorization": "Bearer <token>",
            "Content-Type": "multipart/form-data"
          },
          "body": {
            "date": "string YYYY-MM-DD (required)",
            "week_number": "integer (required)",
            "activity_description": "string (required, min 50 chars)",
            "tools_equipment": "string (required, min 10 chars)",
            "skills_acquired": "string (required, min 10 chars)",
            "challenges_faced": "string (required, min 10 chars)",
            "files": "file array (optional, max 5 files, 10MB each)"
          }
        },
        "response": {
          "status": 201,
          "body": {
            "success": "boolean",
            "message": "string",
            "data": "object (entry with files)"
          }
        }
      },
      {
        "id": "log_list",
        "name": "List Log Entries",
        "method": "GET",
        "path": "/log-entries",
        "fullUrl": "/api/log-entries",
        "protected": true,
        "requiredRole": ["student"],
        "description": "Get paginated log entries",
